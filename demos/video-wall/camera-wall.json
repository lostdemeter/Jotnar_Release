{
  "schema": "jotnar.stream/1",
  "name": "camera-wall",
  "clock": {"fps": 15, "deadline_ms": 66, "max_in_flight": 1},
  "source": {
    "kind": "camera",
    "device": "/dev/video0",
    "width": 640,
    "height": 360,
    "channels": 3,
    "format": "rgb24",
    "capture_width": 1280,
    "capture_height": 720,
    "capture_fps": 30
  },
  "stage": {
    "listing": "demos/doom-two-nodes/upscale-half.asm",
    "descriptor": "demos/video-wall/wall-stage.json",
    "targets": ["cuda", "hip"]
  },
  "placement": {"cuda": 1, "hip": 3},
  "sink": {"kind": "tcp", "listen": "127.0.0.1:9990", "title": "Jotnar Wall", "hud": true},
  "merge": "tile-grid",
  "backpressure": "drop-oldest",
  "determinism": "exact",
  "receipt": {"kind": "every-frame", "dir": "/tmp/opencode/wall-live-receipt"}
}
